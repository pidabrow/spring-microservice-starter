{
  "version": 1,
  "permissions": {
    "allow": [
      "Shell(./gradlew test:*)",
      "Shell(./gradlew :*:test:*)",
      "Shell(./gradlew build)",
      "Shell(./gradlew :*:build)",
      "Shell(./gradlew check)",
      "Shell(./gradlew :*:check)",
      "Shell(./gradlew tasks:*)",
      "Shell(./gradlew dependencies:*)",
      "Shell(./gradlew :*:dependencies:*)",
      "Shell(./gradlew projects)",
      "Shell(./gradlew help:*)",

      "Shell(git status)",
      "Shell(git status:*)",
      "Shell(git diff)",
      "Shell(git diff:*)",
      "Shell(git log:*)",
      "Shell(git show:*)",
      "Shell(git branch:*)",
      "Shell(git fetch:*)",
      "Shell(git remote -v)",
      "Shell(git stash list)",
      "Shell(git add:*)",
      "Shell(git commit:*)",
      "Shell(git checkout -b feature/*)",
      "Shell(git checkout feature/*)",
      "Shell(git switch feature/*)",
      "Shell(git switch -c feature/*)",
      "Shell(git restore:*)",
      "Shell(git push)",
      "Shell(git push origin feature/*)",
      "Shell(git push -u origin feature/*)",

      "Shell(gh pr create:*)",
      "Shell(gh pr view:*)",
      "Shell(gh pr checks:*)",
      "Shell(gh pr list:*)",
      "Shell(gh pr edit:*)",
      "Shell(gh pr diff:*)",
      "Shell(gh pr comment:*)",
      "Shell(gh run view:*)",
      "Shell(gh run list:*)",
      "Shell(gh run watch:*)",
      "Shell(gh repo view:*)",
      "Shell(gh issue view:*)",
      "Shell(gh issue list:*)",

      "Shell(find:*)",
      "Shell(grep:*)",
      "Shell(rg:*)",
      "Shell(cat:*)",
      "Shell(head:*)",
      "Shell(tail:*)",
      "Shell(ls:*)",
      "Shell(wc:*)",
      "Shell(tree:*)",
      "Shell(file:*)",
      "Shell(xargs:*)",

      "Shell(jar tf:*)",
      "Shell(unzip -l:*)",
      "Shell(unzip -p:*)",
      "Shell(python3 -c:*)",
      "Shell(echo:*)",
      "Shell(sleep:*)",
      "Shell(true)",
      "Shell(false)",

      "Read(**)",
      "Write(**)"
    ],
    "deny": [
      "Shell(rm -rf:*)",
      "Shell(rm -r:*)",
      "Shell(rm -fr:*)",
      "Shell(sudo:*)",
      "Shell(chmod 777:*)",
      "Shell(curl:* | sh*)",
      "Shell(curl:* | bash*)",
      "Shell(wget:* | sh*)",
      "Shell(wget:* | bash*)",

      "Shell(git push --force:*)",
      "Shell(git push -f:*)",
      "Shell(git push --force-with-lease:*)",
      "Shell(git push origin main:*)",
      "Shell(git push origin master:*)",
      "Shell(git push:* main)",
      "Shell(git push:* master)",
      "Shell(git reset --hard:*)",
      "Shell(git clean -fd:*)",
      "Shell(git checkout main)",
      "Shell(git checkout master)",
      "Shell(git switch main)",
      "Shell(git switch master)",

      "Shell(gh pr merge:*)",
      "Shell(gh release:*)",
      "Shell(gh repo delete:*)",
      "Shell(gh repo create:*)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  }
}
